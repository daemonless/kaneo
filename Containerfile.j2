ARG BASE_VERSION=15

# --- Stage 1: Builder ---
FROM ghcr.io/daemonless/base-exec:${BASE_VERSION} AS builder

ARG FREEBSD_ARCH=amd64
ARG BUILDER_PACKAGES="node24 npm-node24 git-lite jq ca_root_nss"
ARG UPSTREAM_URL="https://api.github.com/repos/usekaneo/kaneo/releases/latest"
ARG UPSTREAM_JQ=".tag_name"

RUN pkg update && \
    pkg install -y ${BUILDER_PACKAGES} && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/*

# pnpm >=12 ships only Linux/macOS/Windows native binaries with no JS fallback;
# pnpm 11 is the last pure-JS release and uses the same v9 lockfile format.
RUN npm install -g --ignore-scripts pnpm@11

WORKDIR /build
RUN KANEO_VERSION=$(fetch -qo - "${UPSTREAM_URL}" | jq -r "${UPSTREAM_JQ}") && \
    echo "Building Kaneo ${KANEO_VERSION}" && \
    git clone --depth 1 --branch "${KANEO_VERSION}" https://github.com/usekaneo/kaneo.git /build && \
    mkdir -p /app && \
    echo "${KANEO_VERSION#v}" > /app/version

# Restrict pnpm optional platform downloads to FreeBSD and wasm32, and strip
# the pnpm 12 packageManager pin and husky prepare hook.
RUN sed -i '' 's/"packageManager":.*//g; s/"prepare": "husky"/"prepare": ""/g' package.json && \
    printf 'supportedArchitectures:\n  os:\n    - freebsd\n  cpu:\n    - x64\n    - arm64\n    - wasm32\n' >> pnpm-workspace.yaml && \
    HUSKY=0 pnpm --pm-on-fail=ignore install --frozen-lockfile

# vite-plus-core bundles rolldown and looks for the FreeBSD native binding alongside its dist files
RUN BINDING=$(find /build/node_modules/.pnpm -name "rolldown-binding.freebsd-*.node" 2>/dev/null | head -1) && \
    if [ -n "$BINDING" ]; then \
        BINDING_NAME=$(basename "$BINDING") && \
        find /build/node_modules/.pnpm -path "*/vite-plus-core*/dist/rolldown/shared" -type d 2>/dev/null | \
            xargs -I{} cp "$BINDING" "{}/$BINDING_NAME" && \
        find /build/node_modules/.pnpm -path "*/vite-plus*/binding" -type d 2>/dev/null | \
            xargs -I{} cp "$BINDING" "{}/$BINDING_NAME"; \
    fi

# Build workspace packages and API bundle
RUN cd /build/packages/email && ./node_modules/.bin/tsc --incremental false && \
    cd /build/packages/permissions && ./node_modules/.bin/tsc && \
    cd /build/packages/importers && ./node_modules/.bin/tsc -p tsconfig.json && \
    cd /build/packages/mcp && ./node_modules/.bin/tsc -p tsconfig.json && \
    cd /build/packages/editor && ./node_modules/.bin/tsc && \
    cd /build/apps/api && ./node_modules/.bin/esbuild src/index.ts \
        --bundle --platform=node --outdir=dist --format=esm --packages=external \
        --external:fs --external:path --external:crypto --external:os --external:util \
        --external:stream --external:buffer --external:events --external:url \
        --external:querystring --external:http --external:https --external:net \
        --external:tls --external:zlib --external:@modelcontextprotocol/sdk

# Build web frontend via vite-plus-core's JS build API (the vp Rust CLI binary is not built for FreeBSD)
RUN sed -i '' 's/import { defineConfig, lazyPlugins } from "vite-plus";/import { defineConfig } from "vite"; const lazyPlugins = (fn: any) => fn();/' /build/apps/web/vite.config.ts && \
    cd /build/apps/web && \
    NODE_ENV=production node --input-type=module -e 'import { build } from "vite"; await build();' && \
    find /build/apps/web/dist -type f -name '*.map' -delete

# Assemble production runtime tree in /app and run upstream dependency layout verification
RUN mkdir -p /app/apps/api /app/packages/typescript-config /app/packages/libs \
        /app/packages/email /app/packages/permissions /app/packages/importers /app/packages/mcp && \
    cp /build/package.json /build/pnpm-lock.yaml /build/pnpm-workspace.yaml /app/ && \
    cp -R /build/patches /app/patches && \
    cp /build/apps/api/package.json /app/apps/api/ && \
    cp /build/packages/typescript-config/package.json /app/packages/typescript-config/ && \
    cp /build/packages/libs/package.json /app/packages/libs/ && \
    cp /build/packages/email/package.json /app/packages/email/ && \
    cp /build/packages/permissions/package.json /app/packages/permissions/ && \
    cp /build/packages/importers/package.json /app/packages/importers/ && \
    cp /build/packages/mcp/package.json /app/packages/mcp/ && \
    cd /app && \
    HUSKY=0 NODE_ENV=production pnpm --pm-on-fail=ignore install --prod --frozen-lockfile --no-optional --prefer-offline && \
    cp -R /build/apps/api/dist /app/apps/api/dist && \
    cp -R /build/apps/api/drizzle /app/apps/api/drizzle && \
    cp -R /build/packages/email/dist /app/packages/email/dist && \
    cp -R /build/packages/permissions/dist /app/packages/permissions/dist && \
    cp -R /build/packages/importers/dist /app/packages/importers/dist && \
    cp -R /build/packages/mcp/dist /app/packages/mcp/dist && \
    cd /app/apps/api && \
    node -e "const fs=require('fs');for(const m of ['bcryptjs','hono','pg','drizzle-orm','better-auth','ioredis','valibot','octokit','@modelcontextprotocol/sdk']){fs.accessSync('node_modules/'+m+'/package.json')}for(const m of ['email','permissions','importers']){fs.accessSync('node_modules/@kaneo/'+m+'/dist/index.js')}" && \
    node --input-type=module -e "import { registerTools } from '@kaneo/mcp/tools'; if (typeof registerTools !== 'function') process.exit(1)" && \
    chmod -R a+rX /app /build/apps/web/dist

# --- Stage 2: Runtime ---
FROM ghcr.io/daemonless/base-exec:${BASE_VERSION}

ARG FREEBSD_ARCH=amd64
ARG PACKAGES="node24 nginx ca_root_nss"
ARG UPSTREAM_URL="https://api.github.com/repos/usekaneo/kaneo/releases/latest"
ARG UPSTREAM_JQ=".tag_name"
{%- if ports %}
ARG HEALTHCHECK_ENDPOINT="http://localhost:{{ ports[0].port }}/api/health"
{%- else %}
ARG HEALTHCHECK_ENDPOINT="http://localhost:5173/api/health"
{%- endif %}

ENV HEALTHCHECK_URL="${HEALTHCHECK_ENDPOINT}"

# --- Metadata (Injected by Generator) ---
LABEL org.opencontainers.image.title="{{ title }}" \
      org.opencontainers.image.description="{{ description }}" \
      org.opencontainers.image.source="{{ repo_url }}" \
      org.opencontainers.image.url="{{ web_url }}" \
      org.opencontainers.image.documentation="https://kaneo.app/docs" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="daemonless" \
      org.opencontainers.image.authors="daemonless" \
      io.daemonless.category="{{ category }}" \
{%- if ports %}
      io.daemonless.port="{{ ports[0].port }}" \
{%- endif %}
{%- if volumes %}
      io.daemonless.volumes="{{ volumes | map(attribute='path') | join(',') }}" \
{%- endif %}
{%- if mlock %}
      org.freebsd.jail.allow.mlock="required" \
{%- endif %}
      io.daemonless.arch="${FREEBSD_ARCH}" \
      io.daemonless.upstream-url="${UPSTREAM_URL}" \
      io.daemonless.upstream-jq="${UPSTREAM_JQ}" \
      io.daemonless.healthcheck-url="${HEALTHCHECK_ENDPOINT}" \
      io.daemonless.packages="${PACKAGES}"

# Install runtime dependencies and prepare nginx & runtime directories
RUN pkg update && \
    pkg install -y ${PACKAGES} && \
    pkg clean -ay && \
    rm -rf /var/cache/pkg/* /var/db/pkg/repos/* && \
    mkdir -p /etc/nginx/conf.d /usr/share/nginx/html /docker-entrypoint.d /var/lib/kaneo /config && \
    cp /usr/local/etc/nginx/mime.types /etc/nginx/mime.types

WORKDIR /app

COPY --from=builder --chown=bsd:bsd /app /app
COPY --from=builder --chown=bsd:bsd /build/apps/web/dist /usr/share/nginx/html
COPY --from=builder /build/apps/web/nginx.main.conf /etc/nginx/nginx.conf
COPY --from=builder --chown=bsd:bsd /build/apps/web/nginx.kaneo.conf /etc/nginx/conf.d/default.conf
COPY --from=builder --chown=bsd:bsd /build/apps/web/runtime-storage.sh /docker-entrypoint.d/05-kaneo-runtime-storage.sh
COPY --from=builder --chown=bsd:bsd /build/apps/web/env.sh /docker-entrypoint.d/env.sh
COPY --from=builder --chown=bsd:bsd /build/apps/web/env.awk /docker-entrypoint.d/env.awk

COPY root/ /

RUN chmod +x /docker-entrypoint.d/05-kaneo-runtime-storage.sh \
        /docker-entrypoint.d/env.sh \
        /daemonless/init.d/* \
        /daemonless/libexec/kaneo \
        /healthz && \
    chown -R bsd:bsd /var/lib/kaneo /config

CMD ["/daemonless/libexec/kaneo"]

# --- Expose (Injected by Generator) ---
{%- if ports %}
EXPOSE {{ ports | map(attribute='port') | join(' ') }}
{%- endif %}

# --- Volumes (Injected by Generator) ---
{%- if volumes %}
VOLUME {{ volumes | map(attribute='path') | join(' ') }}
{%- endif %}
